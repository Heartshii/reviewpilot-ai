{
  "name": "reviewpilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "convex:push": "convex dev --once --env-file .env.local",
    "migrations:list": "node scripts/convex-migrations.mjs list",
    "migrations:check": "node scripts/convex-migrations.mjs check",
    "build": "next build",
    "storybook": "set CACHE_DIR=.cache&&storybook dev -p 6006",
    "build-storybook": "set CACHE_DIR=.cache&&storybook build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.1",
    "@convex-dev/twilio": "^0.2.1",
    "@sentry/nextjs": "^10.51.0",
    "convex": "^1.32.0",
    "next": "16.1.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "stripe": "^22.1.0",
    "twilio": "^5.12.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
